# Public source tree: opt in editor, patches, and their current documentation.
# Everything else remains local, including game installations, disassembly,
# converted scenarios, research notes, one-off scripts, and test fixtures.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/scenario_editor.py
!/scenario_converter.py

!/lib/
/lib/*
!/lib/*.py
/lib/reinforcement_parser.py
/lib/shared_game.py

# Maintained patch, library-generation, and sound-setup commands only.
!/tools/
/tools/*
!/tools/patch_dday.py
!/tools/build_dday_patch.py
!/tools/build_dday_library_patch.py
!/tools/build_dday_music_patch.py
!/tools/build_dday_air_weather_patch.py
!/tools/build_terrain_library.py
!/tools/build_unit_library.py
!/tools/build_presentation_library.py
!/tools/build_music_library.py
!/tools/fix_sound_config.py
!/tools/sound_config_editor.py

# Keep patches and the DOS selector; never include game data or executables.
!/game/
/game/*
!/game/waw/
/game/waw/*
!/game/waw/README.md
!/game/waw/patches/
/game/waw/patches/*
!/game/waw/patches/README.md
!/game/waw/patches/*.asm
!/game/waw/patches/*.ips
!/game/waw/patches/*.json
!/game/waw/patches/history/
/game/waw/patches/history/*
!/game/waw/patches/history/dday-music-v1.ips
!/game/waw/patches/history/dday-music-v1.undo.ips
!/game/waw/patches/history/dday-music-v1.json
!/game/waw/dday/
/game/waw/dday/*
!/game/waw/dday/SELECT.BAT

# Current user/format guides; the rest of txt/ is local research history.
!/txt/
/txt/*
!/txt/SCENARIO_EDITOR_README.md
!/txt/SCENARIO_PACK.md
!/txt/WAW_CONVERSION.md
!/txt/V4V_CONVERSION.md
!/txt/GAME_PROFILES.md
!/txt/TERRAIN_RULES.md
!/txt/NESTED_EVENTS.md
!/txt/UNIT_LOGISTICS_AND_ORDERS.md
!/txt/AIRCRAFT_AND_NAVAL.md
!/txt/SOUND_CONFIGURATION_GUIDE.md

# Game-derived terrain, unit, portrait, and music libraries are generated locally.
!/assets/
/assets/*
!/assets/app/
/assets/app/*
!/assets/app/icon.png
!/assets/app/icon.ico
!/assets/app/README.md
!/assets/music/
/assets/music/*
!/assets/music/README.md

# Screenshots used by README.md, rather than arbitrary captures/downloads.
!/www/
/www/*
!/www/image/
/www/image/*
!/www/image/editor-map.png
!/www/image/editor-units.png
!/www/image/editor-artwork.png

# Temporary files are excluded even within public source directories.
__pycache__/
*.py[cod]
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
